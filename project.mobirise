    "obladnannya-ta-zapchastyny.html": {
      "settings": {
        "title": "Обладнання та запчастини",
        "order": "4",
        "meta_descr": "Виготовлення, ремонт та модернізація гірничо-металургійного обладнання, металоконструкцій і запчастин. Повний цикл виробництва за ТЗ замовника. Гарантія якості!",
        "meta_image": "@PROJECT_PATH@/assets/images/41-720x720.jpg"
      },
      "components": [
        {
          "alias": false,
