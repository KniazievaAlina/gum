    "en.html": {
      "settings": {
        "title": "LLC \"TD \"GUM\"",
        "meta_descr": "‘Guild of Ukrainian Machine Builders’ Trading House Ltd is a modern Ukrainian company which, since 2010, has specialised in the manufacture, major overhaul and modernisation of mining and metallurgical equipment, as well as the production of high-quality steel structures based on drawings of any complexity.",
        "header_custom": "",
        "footer_custom": "",
